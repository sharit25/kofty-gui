# hello_ui.kfy
<MainApp>:
    <BoxLayout>:
        orientation: "vertical"

        Label:
            text: "Welcome to Kivy Style"
            color: 0, 0, 0

        Button:
            text: "Red Button"
            size: 200, 50
            color: 255, 0, 0

        Button:
            text: "Blue Button"
            size: 200, 50
            color: 0, 0, 255

        Button:
            text: "Green Button"
            size: 200, 50
            color: 0, 255, 0